# Connection to your Ghost site (the MCP client usually injects these as env vars;
# a local .env is only for development/testing).
GHOST_URL=https://your-site.com
GHOST_ADMIN_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx:yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy
GHOST_API_VERSION=v5.0

# Default author (slug or email) for created posts, optional.
DEFAULT_AUTHOR_SLUG=
